# ==========================================================================
# SmartEng – Environment Configuration (EXAMPLE / TEMPLATE)
# ==========================================================================
# ⚠️  FILE NÀY ĐƯỢC COMMIT LÊN GIT – KHÔNG ĐIỀN GIÁ TRỊ THẬT VÀO ĐÂY.
#
#     Cách dùng:
#       1. Tạo bản sao thành `backend/.env` (file này đã bị .gitignore chặn)
#       2. Điền giá trị thật của bạn vào `backend/.env`
#
#        Windows:   copy backend\.env.example backend\.env
#        macOS/Linux: cp backend/.env.example backend/.env

# ── Database (MySQL Aiven) ─────────────────────────────────────────────────
# URL đầy đủ – driver pymysql + SSL
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>

# Thành phần kết nối riêng lẻ (dùng cho script migrate, tool CLI…)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=your_db_host.example.com
DB_PORT=3306
DB_NAME=your_db_name

# Đường dẫn tới CA certificate của Aiven (tính từ thư mục backend/)
DB_SSL_CA=ca.pem
# Bật/tắt SSL khi kết nối DB (1 = bật, 0 = tắt)
DB_USE_SSL=1

# ── AI API (OpenRouter – đang dùng bởi code hiện tại) ─────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=inclusionai/ling-3.0-flash:free

# ── AI API (Gemini – dự phòng cho tương lai) ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── Registration email verification (SMTP) ────────────────────────────────
# Gmail example: host=smtp.gmail.com, port=587, username=your Gmail address,
# password=a Google App Password (not your normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=SmartEng
SMTP_USE_TLS=1
# Long random value used to protect stored verification-code digests.
EMAIL_VERIFICATION_SECRET=replace_with_a_long_random_secret
